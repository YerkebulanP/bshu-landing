# Скопируйте в .env и заполните.
# NEXT_PUBLIC_* инлайнятся В СБОРКУ — после изменения нужен пересбор
# (docker compose up -d --build).

# Полный адрес приложения для участников (личные кабинеты, голосование).
# Кнопка «Вход для участников» в шапке ведёт на ${NEXT_PUBLIC_APP_URL}/login.
# Локально можно оставить пустым — тогда кнопка ведёт на якорь-заглушку.
NEXT_PUBLIC_APP_URL=https://app.upgradeplatform.kz

# Домен(ы) лендинга — используется в Caddyfile при деплое.
SITE_DOMAIN=upgradeplatform.kz
