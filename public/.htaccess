# Лендинг на Apache (Plesk). Модули под <IfModule> — если модуля нет, блок
# просто игнорируется и сайт продолжает работать.

# Голый домен → /ru/ (временный редирект; если mod_rewrite недоступен —
# сработает заглушка index.html с meta-refresh).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^$ /ru/ [R=302,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  # CSS/JS Next лежат в _next/static с хэшем в имени — можно кэшировать надолго.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # Картинки без хэша в имени — неделя, чтобы замена файла доходила до людей.
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
</IfModule>
